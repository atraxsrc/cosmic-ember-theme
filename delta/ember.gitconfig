# Ember for delta (the git diff pager), part of cosmic-ember-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Ember theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/ember.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = ember

[delta "ember"]
    dark = true
    syntax-theme = Ember
    navigate = true
    line-numbers = true

    file-style = bold "#E8713A"
    file-decoration-style = "#7C8290" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#7C8290" box
    hunk-header-file-style = "#808693"
    hunk-header-line-number-style = "#D9A441"

    minus-style = "#D85A5A" "#15171C"
    minus-emph-style = bold "#1B1E24" "#D85A5A"
    minus-non-emph-style = "#D85A5A" "#15171C"
    plus-style = "#8FB58A" "#15171C"
    plus-emph-style = bold "#1B1E24" "#8FB58A"
    plus-non-emph-style = "#8FB58A" "#15171C"
    zero-style = syntax
    whitespace-error-style = "#1B1E24" "#D9A441"

    line-numbers-left-style = "#7C8290"
    line-numbers-right-style = "#7C8290"
    line-numbers-minus-style = "#D85A5A"
    line-numbers-plus-style = "#8FB58A"
    line-numbers-zero-style = "#5A6070"

    commit-style = bold "#D9A441"
    commit-decoration-style = "#7C8290" box
    blame-palette = "#1B1E24 #15171C #2D3036"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#8FB58A"
    merge-conflict-theirs-diff-header-style = bold "#D9A441"
