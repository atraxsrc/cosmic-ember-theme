# Ember for Ghostty, part of cosmic-ember-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Ember
# or, with the Ember Day half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Ember,light:EmberDay

